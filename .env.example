# D9W German Language Institute — Environment Configuration
# NOTE: Server-side environment variables for Vercel / Node.js
# NEVER prefix these with VITE_ to prevent leaking them to browser bundles!

# Microsoft Power Automate Webhook URL for Lead Capture Flow
# Generated in Power Automate: "When an HTTP request is received"
# Example: https://prod-XX.westeurope.logic.azure.com:443/workflows/.../triggers/manual/paths/invoke?...
POWER_AUTOMATE_LEAD_WEBHOOK_URL=

# Optional shared secret between D9W Vercel API and Power Automate flow
# Sent in the X-Lead-Secret header to verify caller authenticity
LEAD_API_SECRET=
