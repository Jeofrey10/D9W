{
  "name": "d9w-german-hub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test:foundations": "node scripts/test-phase-03-foundations.mjs",
    "test:leads": "node scripts/test-leads-api.mjs",
    "test:listening": "node scripts/test-listening-engine.mjs",
    "test:reading": "node scripts/test-reading-engine.mjs",
    "test:daily-word": "node scripts/test-daily-word-engine.mjs",
    "test:cases": "node scripts/test-case-translator.mjs",
    "test:planner": "node scripts/test-study-planner.mjs",
    "test:i18n": "node scripts/test-i18n-system.mjs",
    "test:e2e": "playwright test",
    "test:all": "npm run test:foundations && npm run test:leads && npm run test:listening && npm run test:reading && npm run test:daily-word && npm run test:cases && npm run test:planner && npm run test:i18n",
    "create:workbook": "python scripts/create_d9w_leads_workbook.py",
    "create:audio": "python scripts/generate_listening_audio.py",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "clsx": "^2.1.1",
